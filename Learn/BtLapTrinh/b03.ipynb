    "from math import *\n",
    "def gt(n):\n",
    "    x = 1\n",
    "    for i in range(1, n + 1):\n",
    "        x *= i\n",
    "    return x\n",
    "def ham(n):\n",
    "    x = 0\n",
    "    while n % 10 != 0:\n",
    "        x += gt(n % 10)\n",
    "        n //= 10\n",
    "    return x\n",
    "n = 123\n",
    "print(ham(n))"
   ]
  }
